# Byte-compiled / Python internal cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Virtual Envs
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
*.env

# IDEs & Code Editors
.vscode/
.idea/
*.swp
*.swo

# OS Generated Files
.DS_Store
Thumbs.db

# Data & Logs (raw/processed data shouldn't be committed — too large / regenerable)
*.log
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python build artifacts / packaging
dist/
build/
*.egg-info/
*.egg

# Caches (pytest, mypy, ruff, coverage)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# uv cache (not the lockfile — uv.lock SHOULD be committed)
.uv_cache/
.uv/

# Docker / Airflow
airflow.db
*.pid